{
  "schedules": [
    {
      "name": "daily at 08:00",
      "cron": "0 8 * * *",
      "start": "2026-09-14",
      "count": 3,
      "tz": "UTC",
      "expected": [
        "2026-09-14T08:00:00Z",
        "2026-09-15T08:00:00Z",
        "2026-09-16T08:00:00Z"
      ]
    },
    {
      "name": "weekdays at 08:00",
      "cron": "0 8 * * MON-FRI",
      "start": "2026-09-12",
      "count": 5,
      "tz": "UTC",
      "expected": [
        "2026-09-14T08:00:00Z",
        "2026-09-15T08:00:00Z",
        "2026-09-16T08:00:00Z",
        "2026-09-17T08:00:00Z",
        "2026-09-18T08:00:00Z"
      ]
    },
    {
      "name": "every 15 minutes",
      "cron": "*/15 * * * *",
      "start": "2026-09-14",
      "count": 5,
      "tz": "UTC",
      "expected": [
        "2026-09-14T00:00:00Z",
        "2026-09-14T00:15:00Z",
        "2026-09-14T00:30:00Z",
        "2026-09-14T00:45:00Z",
        "2026-09-14T01:00:00Z"
      ]
    },
    {
      "name": "sunday as 0 and 7",
      "cron": "0 0 * * 0,7",
      "start": "2026-09-01",
      "count": 3,
      "tz": "UTC",
      "expected": [
        "2026-09-06T00:00:00Z",
        "2026-09-13T00:00:00Z",
        "2026-09-20T00:00:00Z"
      ]
    },
    {
      "name": "day-of-month OR day-of-week",
      "cron": "0 0 1 * SUN",
      "start": "2026-09-01",
      "count": 6,
      "tz": "UTC",
      "expected": [
        "2026-09-01T00:00:00Z",
        "2026-09-06T00:00:00Z",
        "2026-09-13T00:00:00Z",
        "2026-09-20T00:00:00Z",
        "2026-09-27T00:00:00Z",
        "2026-10-01T00:00:00Z"
      ]
    },
    {
      "name": "monthly on the first",
      "cron": "0 8 1 * *",
      "start": "2026-09-14",
      "count": 3,
      "tz": "UTC",
      "expected": [
        "2026-10-01T08:00:00Z",
        "2026-11-01T08:00:00Z",
        "2026-12-01T08:00:00Z"
      ]
    },
    {
      "name": "weekly on monday",
      "cron": "0 8 * * MON",
      "start": "2026-09-14",
      "count": 3,
      "tz": "UTC",
      "expected": [
        "2026-09-14T08:00:00Z",
        "2026-09-21T08:00:00Z",
        "2026-09-28T08:00:00Z"
      ]
    },
    {
      "name": "hourly at :15",
      "cron": "15 * * * *",
      "start": "2026-09-14",
      "count": 3,
      "tz": "UTC",
      "expected": [
        "2026-09-14T00:15:00Z",
        "2026-09-14T01:15:00Z",
        "2026-09-14T02:15:00Z"
      ]
    },
    {
      "name": "DST spring: 08:00 keeps its local hour",
      "cron": "0 8 * * *",
      "start": "2026-03-28",
      "count": 3,
      "tz": "Europe/Stockholm",
      "expected": [
        "2026-03-28T07:00:00Z",
        "2026-03-29T06:00:00Z",
        "2026-03-30T06:00:00Z"
      ]
    },
    {
      "name": "DST spring: 02:30 is skipped on the transition day",
      "cron": "30 2 * * *",
      "start": "2026-03-28",
      "count": 3,
      "tz": "Europe/Stockholm",
      "expected": [
        "2026-03-28T01:30:00Z",
        "2026-03-30T00:30:00Z",
        "2026-03-31T00:30:00Z"
      ]
    },
    {
      "name": "DST autumn: 02:30 takes its first occurrence",
      "cron": "30 2 * * *",
      "start": "2026-10-24",
      "count": 3,
      "tz": "Europe/Stockholm",
      "expected": [
        "2026-10-24T00:30:00Z",
        "2026-10-25T00:30:00Z",
        "2026-10-26T01:30:00Z"
      ]
    },
    {
      "name": "month names",
      "cron": "0 0 1 JAN,JUL *",
      "start": "2026-02-01",
      "count": 3,
      "tz": "UTC",
      "expected": [
        "2026-07-01T00:00:00Z",
        "2027-01-01T00:00:00Z",
        "2027-07-01T00:00:00Z"
      ]
    }
  ],
  "intervals": [
    {
      "name": "hourly at :15",
      "interval": "hourly",
      "offset": "15",
      "cron": "15 * * * *"
    },
    {
      "name": "daily at 08:00",
      "interval": "daily",
      "offset": "08:00",
      "cron": "0 8 * * *"
    },
    {
      "name": "weekly on monday",
      "interval": "weekly",
      "offset": "MON:08:00",
      "cron": "0 8 * * MON"
    },
    {
      "name": "monthly on the first",
      "interval": "monthly",
      "offset": "1:08:00",
      "cron": "0 8 1 * *"
    },
    {
      "name": "hourly default offset",
      "interval": "hourly",
      "offset": null,
      "cron": "0 * * * *"
    },
    {
      "name": "daily default offset",
      "interval": "daily",
      "offset": null,
      "cron": "0 0 * * *"
    },
    {
      "name": "weekly default offset",
      "interval": "weekly",
      "offset": null,
      "cron": "0 0 * * MON"
    },
    {
      "name": "monthly default offset",
      "interval": "monthly",
      "offset": null,
      "cron": "0 0 1 * *"
    }
  ]
}
