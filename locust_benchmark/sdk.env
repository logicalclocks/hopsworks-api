# SDK builds to benchmark.
# For each name in SDKS set <name>_REPO (a git URL) and <name>_REF (a branch, tag or commit).
# build_images.sh builds locust-hsfs:<name>.
# k8s/push_images.sh pushes it as <REGISTRY>:<name>-<first 8 characters of the ref>.
# Pin commits when comparing builds, so a moving branch does not change the result.
#
# To compare a change against main, add a second build:
#   SDKS="main change"
#   change_REPO=https://github.com/<fork>/hopsworks-api.git
#   change_REF=<commit>
SDKS="main"
main_REPO=https://github.com/logicalclocks/hopsworks-api.git
main_REF=main
