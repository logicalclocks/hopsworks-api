# Cluster-specific settings for k8s/run.sh and k8s/push_images.sh.
# kubectl uses the exported KUBECONFIG.

# Namespace the Jobs, Service, ConfigMap and Secret are created in.
NAMESPACE=hopsworks
# Image repository the cluster can pull from.
# Images are tagged <name>-<first 8 characters of the SDK ref>.
REGISTRY="<registry-host>/<project>/locust-hsfs"
# Optional dockerconfigjson Secret in NAMESPACE for pulling from REGISTRY.
# When set, push_images.sh also logs the local Docker in to the registry with it.
PULL_SECRET=
# Optional node the locust pods prefer.
# Pick one without the RonDB REST server or ingress, so the load generator does not compete with what it measures.
# Pods spill over to other nodes when it is full.
PREFERRED_NODE=
# Per pod.
# A worker runs one gevent process, so it never uses more than one core.
MASTER_CPU=500m
WORKER_CPU=1
MEMORY_REQUEST=512Mi
MEMORY_LIMIT=1Gi
